# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend API ---
DATABASE_URL=postgresql://animator:animator@db:5432/animator
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/renders

# --- Auth (Supabase) ---
# Same project URL as the frontend's NEXT_PUBLIC_SUPABASE_URL. Access tokens
# are verified against this project's public JWKS — no secret goes here.
# LEAVE BLANK TO DISABLE AUTH (the API then accepts every request; useful for
# driving the pipeline with curl, never for anything deployed).
SUPABASE_URL=

# --- LLM / codegen ---
# Manim scene code (OpenAI). Use the full `-luna` id — the bare `gpt-5.6`
# alias routes to a different model in the family (Sol).
LLM_API_KEY=changeme
LLM_MODEL=gpt-5.6-luna
# Narration script (Gemini)
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-3.7-flash
# Narration provider: "gemini" (falls back to OpenAI automatically if Gemini
# errors — the free tier returns 503/429 in bursts) or "openai" to skip Gemini
# entirely. Nano-tier model, so narration costs a fraction of a cent per job.
NARRATION_PROVIDER=gemini
NARRATION_FALLBACK_MODEL=gpt-5.4-nano

# --- Text-to-speech (voiceover) ---
# Uses OpenAI's speech endpoint. Leave TTS_API_KEY blank to reuse LLM_API_KEY
# (same account). ~$0.015 per minute of audio, so ~1.5c per video.
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
# gpt-4o-mini-tts voices: alloy, ash, ballad, coral, echo, fable, nova, onyx,
# sage, shimmer, verse
TTS_VOICE=alloy

# --- Render sandbox ---
# Absolute path, as the HOST sees it, to ./storage/work. The worker runs in a
# container but drives the host's Docker daemon, which resolves sandbox
# bind-mount sources on the host — so it needs the host's own path. Use
# forward slashes on Windows.
SANDBOX_WORK_HOST_DIR=/absolute/path/to/repo/storage/work
SANDBOX_IMAGE=2danimator-sandbox:latest
RENDER_TIMEOUT_SECONDS=300
