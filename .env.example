# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend API ---
DATABASE_URL=postgresql://animator:animator@db:5432/animator
REDIS_URL=redis://redis:6379/0
STORAGE_DIR=/data/renders

# --- LLM / codegen ---
LLM_API_KEY=changeme
LLM_MODEL=claude-sonnet-5

# --- Text-to-speech (voiceover) ---
TTS_API_KEY=changeme
TTS_VOICE=default

# --- Render sandbox ---
SANDBOX_IMAGE=2danimator-sandbox:latest
RENDER_TIMEOUT_SECONDS=300
